---
const points = [
  {
    title: "Built for solo operators",
    body: "You are the business. I focus on the fixes that protect your time, client delivery and credibility.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    title: "Commercially sensible",
    body: "No oversized retainers, no bloated scope, no corporate IT theatre. Just the right fix for the stage you're at.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  },
  {
    title: "Fast, direct help",
    body: "A real person in the UK who can often sort things remotely. Less delay, less friction, less lost time.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
];
---
<section class="wrap why-section">
  <div class="why-header">
    <span class="section-tag">Why this positioning works</span>
    <h2>Why this works for one-man bands</h2>
  </div>
  <div class="why">
    {points.map(p => (
      <div class="point">
        <div class="point-icon" set:html={p.icon} />
        <div>
          <strong>{p.title}</strong>
          <p>{p.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .why-header{max-width:720px;margin-bottom:28px}
  .section-tag{display:inline-flex;margin-bottom:14px;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--gold)}
  .why{display:grid;gap:18px;grid-template-columns:1.15fr .85fr .85fr}
  .point{
    display:flex;
    gap:18px;
    align-items:flex-start;
    background:rgba(255,253,248,.78);
    border:1px solid rgba(255,255,255,.76);
    border-radius:28px;
    padding:26px;
    box-shadow:var(--shadow-card), inset 0 1px 0 rgba(255,255,255,.64);
  }
  .point:first-child{grid-row:span 2;min-height:100%}
  .point-icon{
    flex-shrink:0;
    width:48px;
    height:48px;
    border-radius:15px;
    background:var(--navy);
    color:var(--gold);
    display:flex;
    align-items:center;
    justify-content:center;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.08);
  }
  .point-icon :global(svg){width:22px;height:22px}
  .point strong{display:block;color:var(--navy);font-size:17px;margin-bottom:6px}
  .point p{color:var(--muted);font-size:14.5px;margin:0;line-height:1.65}
  @media (max-width:980px){
    .why{grid-template-columns:1fr}
    .point:first-child{grid-row:auto}
  }
</style>

---
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID ?? "xgororjz";
const action = `https://formspree.io/f/${formspreeId}`;
---
<section class="wrap" id="contact">
  <div class="contact-shell">
    <div class="contact-copy">
      <span class="section-tag">Start here</span>
      <h2>Tell me what's broken, messy or slowing you down</h2>
      <p class="lead">Send the issue over and I'll come back with the next best step. First call is free — no obligation.</p>
      <div class="quick-channels">
        <a class="channel-link" href="tel:+447951638005">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <div>
            <span class="channel-label">Call</span>
            <strong>07951 638005</strong>
          </div>
        </a>
        <a class="channel-link" href="https://wa.me/447951638005?text=Hi%20%E2%80%94%20I%20found%20you%20on%20the%20CJMuse%20website.%20Can%20you%20help%20with..." target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          <div>
            <span class="channel-label">WhatsApp</span>
            <strong>Message me</strong>
          </div>
        </a>
      </div>
      <div class="contact-note">
        <strong>Best for:</strong>
        <span>urgent fixes, email and domain setup, security clean-up, and simple business websites.</span>
      </div>
    </div>
    <div class="contact">
      <form action={action} method="POST">
      <div>
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required />
      </div>
      <div>
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" required />
      </div>
      <div>
        <label for="phone">Best phone number</label>
        <input id="phone" name="phone" type="tel" />
      </div>
      <div>
        <label for="message">What's the headache?</label>
        <textarea id="message" name="message" required></textarea>
      </div>
      <button type="submit">Send message</button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-shell{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1fr);gap:20px;align-items:stretch}
  .section-tag{display:inline-flex;margin-bottom:14px;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--gold)}
  .contact-copy,.contact{border-radius:32px;padding:36px}
  .contact-copy{background:linear-gradient(180deg,rgba(16,24,38,.98),rgba(20,32,52,.95));color:#fff;box-shadow:var(--shadow-soft)}
  .contact-copy h2{color:#fff;max-width:10ch}
  .contact-copy p.lead{color:rgba(247,243,235,.76);font-size:18px;margin-bottom:26px;line-height:1.75}
  .quick-channels{display:grid;gap:10px;margin-bottom:24px}
  .channel-link{display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:18px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);text-decoration:none;color:#fff;transition:background .2s ease, transform .2s ease}
  .channel-link:hover{background:rgba(255,255,255,.1);transform:translateY(-1px)}
  .channel-link svg{width:22px;height:22px;color:var(--gold);flex-shrink:0}
  .channel-label{display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(247,243,235,.6);font-weight:700;margin-bottom:2px}
  .channel-link strong{display:block;font-size:16px;color:#fff;font-weight:600}
  .contact-note{display:grid;gap:8px;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);color:rgba(247,243,235,.78)}
  .contact-note strong{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--gold)}
  .contact{background:rgba(255,255,255,.82);border:1px solid rgba(255,255,255,.76);box-shadow:var(--shadow-card), inset 0 1px 0 rgba(255,255,255,.64)}
  form{display:grid;gap:14px;max-width:560px}
  label{font-size:13px;color:var(--navy);font-weight:700;letter-spacing:.01em}
  input,textarea{
    width:100%;padding:14px 16px;border-radius:14px;
    border:1px solid rgba(16,24,38,.12);background:rgba(255,255,255,.78);color:var(--ink);
    font-family:inherit;font-size:15px;transition:border-color .24s cubic-bezier(.16,1,.3,1),box-shadow .24s cubic-bezier(.16,1,.3,1),transform .24s cubic-bezier(.16,1,.3,1);
  }
  input:focus,textarea:focus{outline:none;border-color:rgba(183,133,63,.72);box-shadow:0 0 0 4px rgba(183,133,63,.12)}
  textarea{min-height:130px;resize:vertical}
  form button{
    background:var(--navy);color:#fff;border:none;
    padding:15px 22px;border-radius:999px;font-weight:700;font-size:15px;
    cursor:pointer;margin-top:6px;justify-self:start;transition:transform .24s cubic-bezier(.16,1,.3,1),background .24s cubic-bezier(.16,1,.3,1);
  }
  form button:hover{background:#0d1420;transform:translateY(-1px)}
  form button:active{transform:translateY(0) scale(.98)}
  @media (max-width:900px){
    .contact-shell{grid-template-columns:1fr}
    .contact-copy h2{max-width:none}
  }
  @media (max-width:600px){
    .contact-copy,.contact{padding:28px 24px}
  }
</style>

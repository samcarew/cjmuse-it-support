---
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap footer-shell">
    <div>
      <div class="brand">CJMuse</div>
      <div class="copy">Plain-English IT support for solo operators across the UK.</div>
    </div>
    <nav class="footer-nav">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="mailto:hello@cjmuse.com">hello@cjmuse.com</a>
    </nav>
    <div class="legal">&copy; {year} CJMuse</div>
  </div>
</footer>

<style>
  footer{padding:28px 0 44px;border-top:1px solid var(--line)}
  .footer-shell{display:grid;grid-template-columns:1fr auto auto;gap:20px;align-items:end}
  .brand{font-family:'Outfit',system-ui,sans-serif;font-size:20px;font-weight:700;color:var(--navy);letter-spacing:-0.03em;margin-bottom:6px}
  .footer-nav{display:flex;flex-wrap:wrap;gap:18px;justify-content:center}
  .footer-nav a{color:var(--navy);text-decoration:none;font-weight:600}
  .footer-nav a:hover{text-decoration:underline}
  .copy,.legal{color:var(--muted);font-size:14px}
  .legal{text-align:right}
  @media (max-width:860px){
    .footer-shell{grid-template-columns:1fr;align-items:start}
    .footer-nav,.legal{text-align:left;justify-content:flex-start}
  }
</style>

---
const proofs = [
  { title: "Email, domains and setup", body: "Ideal for consultants and solo operators who need to look credible fast and stop leaking trust through messy tech." },
  { title: "Fixes that protect billable time", body: "The strongest buying trigger here is lost time. Position the service around getting people back to work quickly." },
  { title: "Simple websites for service businesses", body: "A clean, mobile-friendly site is often enough for a one-man band. Sell practical credibility, not digital theatre." },
];
---
<section class="wrap testimonials">
  <div class="testimonials-head">
    <div>
      <span class="section-tag">Ideal customer profile</span>
      <h2>Best-fit clients</h2>
    </div>
    <p class="intro">The sweet spot is owner-led businesses where broken tech directly hits revenue, responsiveness or professionalism.</p>
  </div>
  <div class="grid">
    {proofs.map(t => (
      <figure class="card">
        <div class="mark">&ldquo;</div>
        <blockquote>{t.body}</blockquote>
        <figcaption>
          <strong>{t.title}</strong>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .testimonials-head{display:grid;grid-template-columns:minmax(0,.9fr) minmax(280px,.9fr);gap:24px;align-items:end;margin-bottom:28px}
  .section-tag{display:inline-flex;margin-bottom:14px;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--gold)}
  .testimonials h2{text-align:left}
  .intro{max-width:760px;color:var(--muted);margin:0;line-height:1.75}
  .grid{
    display:grid;
    gap:18px;
    grid-template-columns:1.1fr .9fr .9fr;
  }
  .card{
    background:linear-gradient(180deg,rgba(255,255,255,.92),rgba(255,253,248,.9));
    border:1px solid rgba(255,255,255,.72);
    border-radius:30px;
    padding:30px 28px 26px;
    margin:0;
    position:relative;
    display:flex;
    flex-direction:column;
    box-shadow:var(--shadow-card), inset 0 1px 0 rgba(255,255,255,.68);
  }
  .mark{
    position:absolute;
    top:10px;
    right:18px;
    font-family:'Outfit',system-ui,sans-serif;
    font-size:72px;
    line-height:1;
    color:rgba(183,133,63,.2);
    pointer-events:none;
  }
  blockquote{
    margin:0 0 22px;
    color:var(--ink);
    font-size:15.5px;
    line-height:1.7;
    flex:1;
  }
  figcaption{
    font-size:14px;
    color:var(--muted);
    border-top:1px solid rgba(16,24,38,.08);
    padding-top:14px;
  }
  figcaption strong{color:var(--navy);font-weight:700;font-style:normal}
  @media (max-width:980px){
    .testimonials-head,.grid{grid-template-columns:1fr}
  }
</style>
